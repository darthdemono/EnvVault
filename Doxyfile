# Doxygen configuration for the EnvVault frontend.
#
# Minimal on purpose: anything not stated here keeps Doxygen's default, so this
# file stays readable instead of becoming the 3,000-line dump `doxygen -g`
# produces. Run it with `npm run docs`, which sets ENVVAULT_VERSION from
# scripts/version.mjs rather than adding a seventh copy of the number.
#
# Scope: src/ts only.
#
# Doxygen cannot parse Rust — there is no Rust front end and there is no
# extension mapping that produces anything useful for it. The four Rust crates
# are documented by `cargo doc` instead (`npm run docs:rust`), and the docs
# workflow publishes both trees side by side under /ts and /rust. Pointing
# Doxygen at vault-core/ would produce a page of misparsed noise, not an
# incomplete-but-useful reference.

PROJECT_NAME           = "EnvVault"
PROJECT_NUMBER         = "$(ENVVAULT_VERSION)"
PROJECT_BRIEF          = "Local-first desktop secrets manager — TypeScript frontend"

OUTPUT_DIRECTORY       = docs/ts
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# ---- Input -------------------------------------------------------------------

INPUT                  = src/ts README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.ts *.md
USE_MDFILE_AS_MAINPAGE = README.md

# TypeScript has no Doxygen front end either, but its Javascript parser handles
# the subset this codebase writes — ES modules, exported functions, JSDoc-style
# `/** */` comments — well enough to be worth having. It does NOT understand
# generics, union types or `as` assertions, so a signature shown here is the
# parser's reading of the declaration, not the type. `npm run typecheck` is the
# authority on types; this is a map of what exists and what it is for.
EXTENSION_MAPPING      = ts=Javascript
OPTIMIZE_OUTPUT_JAVA   = YES

EXCLUDE_PATTERNS       = */node_modules/* */dist/* */coverage/*

# ---- What to extract ---------------------------------------------------------

# EXTRACT_ALL, because a module left out of the tree is invisible rather than
# merely undocumented, and the point of this build is the map. Undocumented
# symbols still get an entry; they just have nothing under the heading.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# The first sentence of a `/** */` block becomes the brief, matching how the
# comments in src/ts are already written.
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# ---- Warnings ----------------------------------------------------------------

# Warnings on, but not fatal. The TypeScript-as-Javascript parse produces
# unavoidable noise on generics and type-only exports; failing the build on it
# would mean the docs job never goes green and is therefore never read.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/ts/doxygen-warnings.log

# ---- Output ------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = TOGGLE
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ---- Diagrams ----------------------------------------------------------------

# Graphviz is required for these; the docs workflow installs it. Include and
# dependency graphs are the ones worth the build time on a 24-module frontend
# whose import cycles are load-bearing (see state.ts's dynamic imports).
#
# CALL_GRAPH / CALLER_GRAPH are off deliberately: on a codebase this size they
# multiply the build by an order of magnitude and produce diagrams too dense to
# read.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 60
