// API Vault v0.5.0 — Full Architecture
// Render: dot -Tsvg architecture.dot -o architecture.svg
//         dot -Tpng architecture.dot -o architecture.png

digraph apivault {
  graph [
    rankdir = "TB"
    fontname = "JetBrains Mono, monospace"
    fontsize = 11
    splines = ortho
    nodesep = 0.55
    ranksep = 0.75
    bgcolor = "#0f1117"
    label = "API Vault v0.5.0 — Architecture\nPhases 1–5 complete"
    labelloc = t
    labeljust = l
    fontcolor = "#aab0c0"
  ]
  node [
    fontname = "JetBrains Mono, monospace"
    fontsize = 10
    style = "filled,rounded"
    shape = box
    margin = "0.18,0.10"
    penwidth = 1.2
  ]
  edge [
    fontname = "JetBrains Mono, monospace"
    fontsize = 9
    color = "#3a4060"
    arrowsize = 0.7
    penwidth = 1.0
  ]

  // ── Colour palette ─────────────────────────────────────────────────────
  // #1e2130  surface1 (dark)
  // #252840  surface2
  // #2e3350  surface3
  // #7364c9  accent (purple)
  // #5ab05a  green (Rust/backend)
  // #5889e0  blue (TypeScript/frontend)
  // #e09a2b  amber (data/storage)
  // #e05252  red (auth/security)
  // #aab0c0  muted text


  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 0 — EXTERNAL / USER
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_external {
    label = "External"
    style = "filled"
    fillcolor = "#12141e"
    color = "#2a2e44"
    fontcolor = "#6a7090"
    fontsize = 10

    user_owner [label = "Owner\n(master password)", fillcolor = "#e0525230", color = "#e05252", fontcolor = "#f08080"]
    user_member [label = "Team Member\n(username+pw or token)", fillcolor = "#7364c930", color = "#7364c9", fontcolor = "#b0a0ef"]
    cli_user [label = "CLI User\n(apiv binary)", fillcolor = "#2e3350", color = "#3a4060", fontcolor = "#aab0c0"]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 1 — ENTRY POINTS
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_entry {
    label = "Entry Points"
    style = "filled"
    fillcolor = "#161824"
    color = "#2a2e44"
    fontcolor = "#6a7090"
    fontsize = 10
    rank = same

    tauri_app [
      label = "Tauri Desktop App\nsrc-tauri/src/main.rs\nv0.5.0 · Linux/Win/macOS"
      fillcolor = "#1a2040"
      color = "#5889e0"
      fontcolor = "#90b0f0"
    ]

    apiv_server [
      label = "apiv-server binary\napiv-server/src/main.rs\nAxum 0.8 · :8743"
      fillcolor = "#1a2040"
      color = "#5889e0"
      fontcolor = "#90b0f0"
    ]

    apiv_cli [
      label = "apiv CLI binary\napiv-cli/src/main.rs\nclap 4 · rpassword"
      fillcolor = "#1a2040"
      color = "#5889e0"
      fontcolor = "#90b0f0"
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 2 — FRONTEND (TypeScript + Vite → dist/)
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_frontend {
    label = "Frontend  src/ts/  (TypeScript + Vite → dist/)"
    style = "filled"
    fillcolor = "#141a2a"
    color = "#2a3260"
    fontcolor = "#6878a8"
    fontsize = 10

    subgraph cluster_ts_bootstrap {
      label = "Bootstrap"
      style = "filled,rounded"
      fillcolor = "#1a2238"
      color = "#3a4878"
      fontcolor = "#7888b8"
      fontsize = 9

      ts_vault [
        label = "vault.ts\nBootstrap · event wiring\nfinishInit() · init()"
        fillcolor = "#252840"
        color = "#7364c9"
        fontcolor = "#c0b0ff"
      ]
    }

    subgraph cluster_ts_state {
      label = "State & Types"
      style = "filled,rounded"
      fillcolor = "#1a2238"
      color = "#3a4878"
      fontsize = 9
      fontcolor = "#7888b8"

      ts_types [
        label = "types.ts\nVaultEntry · VaultData\nProject · AppSettings\nUserInfo · TokenInfo\nPermissionEntry\nAuditRow"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_state [
        label = "state.ts\nst (global mutable bag)\nSettings · VaultStore impls\nLocalVaultStore\nTauriVaultStore\nRemoteVaultStore\nExporter · switchPanel\nswitchTool · applyGridSettings"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]
    }

    subgraph cluster_ts_render {
      label = "Rendering"
      style = "filled,rounded"
      fillcolor = "#1a2238"
      color = "#3a4878"
      fontsize = 9
      fontcolor = "#7888b8"

      ts_render [
        label = "render.ts\nrender() · renderGrid()\nbuildCard() · renderSidebar()\nrenderConfigView()\nrenderProjectTree()"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_filters [
        label = "filters.ts\ngetFiltered() · sorted()\nparseSearch() · buildProjectTree()\ngetDescendantProjectIds()"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]
    }

    subgraph cluster_ts_ui {
      label = "UI Interaction"
      style = "filled,rounded"
      fillcolor = "#1a2238"
      color = "#3a4878"
      fontsize = 9
      fontcolor = "#7888b8"

      ts_modals [
        label = "modals.ts\nopenAdd/Edit/closeModal\nsaveModal · deleteKey\nmarkAsRotated()\nCustomSelect · showDropdown\nshowContextMenu · quickGenerate"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_projects [
        label = "projects.ts\ndoSetFilter()\nrenameCategory · deleteCategory\nrenameProject · deleteProject\nopenProjectCreateModal\nopenCategoryCreateModal"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_chunk_ops [
        label = "chunk-ops.ts\nparsers: parseWgConf\nparseDockerCompose · parseSshConfig\nexporters: exportWireGuard\nexportDockerCompose · exportNginx\nexportK8s · exportSshConfig · exportTraefik\nresolveFieldRef() · renderChunkCard()\nopenChunkEditModal"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_import_export [
        label = "import-export.ts\ncopyAll · exportAs\nhandleFileSelect · parseEnvFile\nopenEnvImportModal\ndoImportEnv"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_lock [
        label = "lock.ts\nshowUnlockModal()\nlockVault() · resetLock()\nauto-lock timer\nsetFinishInitFn()"
        fillcolor = "#252840"
        color = "#e05252"
        fontcolor = "#f09090"
      ]

      ts_settings [
        label = "settings-panel.ts\nopenSettings · saveSettings\nbuildRemoteVaultSection()\napplyRemoteConfig()\nRemoteVaultStore swap"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_tools [
        label = "tools.ts\ninitTools()\n10 tool panes:\nSecret Gen · Password Gen\nUUID/ULID · API Key Patterns\nHash/Derive · JWT Validator\nPEM Cert Gen · SSH Keygen\nString Tools · Base64"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_users [
        label = "users.ts  ★ Phase 5\ninitUsersPanel()\nrenderUsersPanel()\nrenderUserDetail()\nopenCreateUserForm()\nToken create/revoke UI\nPermission add/delete UI"
        fillcolor = "#2a2040"
        color = "#7364c9"
        fontcolor = "#c0b0ff"
      ]
    }

    subgraph cluster_ts_util {
      label = "Utilities"
      style = "filled,rounded"
      fillcolor = "#1a2238"
      color = "#3a4878"
      fontsize = 9
      fontcolor = "#7888b8"

      ts_utils [
        label = "utils.ts\nesc · escAttr · maskKey\nshowToast · showConfirm\nshowPrompt · clipboardWrite\ngenerateULID · SVG consts"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]

      ts_icons [
        label = "icons.ts\nSI_REGISTRY (~300 entries)\nSI_AUTO (50+ aliases)\ninitIconPicker()\niconHTML() · letter-avatar fallback\nSimple Icons CDN"
        fillcolor = "#252840"
        color = "#5889e0"
        fontcolor = "#90b0ef"
      ]
    }

    subgraph cluster_css {
      label = "CSS  src/css/  (14 files)"
      style = "filled,rounded"
      fillcolor = "#1a2238"
      color = "#3a4878"
      fontsize = 9
      fontcolor = "#7888b8"

      css_bundle [
        label = "index.css (@import barrel)\nbase · header · buttons\nsearch · sidebar · content\ncards · modals · settings\nfeedback · responsive\nsidebar-trees · activity-tools\nconfig-view"
        fillcolor = "#1e2438"
        color = "#3a5060"
        fontcolor = "#7898a8"
        shape = note
      ]
    }
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 3 — TAURI BRIDGE
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_tauri {
    label = "Tauri Bridge  src-tauri/src/"
    style = "filled"
    fillcolor = "#16201a"
    color = "#2a4030"
    fontcolor = "#5a8070"
    fontsize = 10

    tauri_lib [
      label = "lib.rs\nVaultState(Mutex<Option<VaultKey>>)\nPath helpers: db_path · salt_path\nmod commands {} ← MANDATORY\n\nVault: unlock/lock/exists/reset\nload/save · get_vault_path\nSettings: load/save\nExpiry: get_expiring · get_audit_log\nGen: generate_certificate\ngenerate_ssh_keypair\nUsers: list/create/delete_user\ncreate/revoke/list_user_tokens\nget/set_user_permissions"
      fillcolor = "#1a2a20"
      color = "#5ab05a"
      fontcolor = "#90d090"
      shape = box
    ]

    tauri_invoke [
      label = "window.__TAURI__.core.invoke\n(IPC bridge)"
      fillcolor = "#1e2820"
      color = "#3a5a40"
      fontcolor = "#6a9070"
      shape = diamond
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 4 — VAULT-CORE (shared Rust library)
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_vault_core {
    label = "vault-core/  (shared Rust library — no Tauri dep)"
    style = "filled"
    fillcolor = "#1a1e10"
    color = "#3a4a20"
    fontcolor = "#6a8040"
    fontsize = 10

    vc_lib [
      label = "lib.rs\nKDF: derive_key() Argon2id\nm=65536 t=3 p=1 → 32-byte key\nread_or_create_salt()\nopen_db() · init_schema()\nload_vault() · save_vault()\nversion_history (cap 50)\nget_expiring_entries()\nload_audit() · append_audit()\nmigrate_legacy_json()\niso_now()"
      fillcolor = "#202814"
      color = "#5ab05a"
      fontcolor = "#90d090"
    ]

    vc_users [
      label = "users.rs  ★ Phase 5\nSchema: users · user_tokens\nuser_permissions\nPassword: SHA-256 + 16B salt\nToken: 32B random → 64-char hex\nStored as SHA-256 hash\ncreate/verify/list/delete_user\ncreate/revoke/list_user_tokens\nget/set_user_permissions\nfilter_vault_for_user()\nmerge_user_vault_write()\nglob_matches() · */?  wildcards"
      fillcolor = "#202814"
      color = "#7364c9"
      fontcolor = "#c0b0ff"
    ]

    vc_generators [
      label = "generators.rs\ngenerate_certificate()\n  rcgen 0.13.2 → X.509 PEM\ngenerate_ssh_keypair()\n  ssh-key 0.6.7 → Ed25519"
      fillcolor = "#202814"
      color = "#5ab05a"
      fontcolor = "#90d090"
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 5 — HTTP API (apiv-server)
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_http_api {
    label = "HTTP API  apiv-server/  (Axum 0.8 · 127.0.0.1:8743)"
    style = "filled"
    fillcolor = "#1a1828"
    color = "#2a2848"
    fontcolor = "#5a5888"
    fontsize = 10

    http_auth [
      label = "Auth Endpoints\nPOST /api/unlock  → owner token\nDELETE /api/unlock → lock\nGET  /api/status\nPOST /api/auth  ★ Phase 5\n  username+pw or {token}"
      fillcolor = "#201e38"
      color = "#e05252"
      fontcolor = "#f09090"
    ]

    http_vault [
      label = "Vault Endpoints\nGET  /api/vault  (filtered for users)\nPUT  /api/vault  (merged write)\nGET  /api/vault/expiring?days=N\nGET  /api/audit"
      fillcolor = "#201e38"
      color = "#5889e0"
      fontcolor = "#90b0f0"
    ]

    http_users [
      label = "User Mgmt  ★ Phase 5 (owner-only)\nGET  /api/users\nPOST /api/users\nDELETE /api/users/:id\nGET  /api/users/:id/tokens\nPOST /api/users/:id/tokens\nDELETE /api/users/:id/tokens/:tid\nGET  /api/users/:id/permissions\nPUT  /api/users/:id/permissions"
      fillcolor = "#201e38"
      color = "#7364c9"
      fontcolor = "#c0b0ff"
    ]

    http_openapi [
      label = "GET /api/openapi.json\n(utoipa 5 · no Swagger UI)"
      fillcolor = "#201e38"
      color = "#3a4060"
      fontcolor = "#8090b0"
      shape = note
    ]

    http_session [
      label = "Session Store\nArc<Mutex<HashMap<UUID, Session>>>\nSession { vault_key: VaultKey\n          user_id: String\n          is_owner: bool }\nIn-memory only (restart = re-auth)"
      fillcolor = "#201e38"
      color = "#e09a2b"
      fontcolor = "#f0c070"
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 6 — CLI (apiv)
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_cli {
    label = "CLI  apiv-cli/  (apiv binary)"
    style = "filled"
    fillcolor = "#1a1a20"
    color = "#2a2a38"
    fontcolor = "#5a5a80"
    fontsize = 10

    cli_cmds [
      label = "Commands  (clap 4)\napiv list      [--project] [--type]\napiv get  <provider>\napiv export    [--format dotenv|yaml|json]\napiv rotate-check [--days N]\napiv import <file.env>\napiv audit [--limit N]\n\nAuth: --password | $APIV_PASSWORD\n  | rpassword interactive prompt\nMode: local DB or --server URL"
      fillcolor = "#202028"
      color = "#5889e0"
      fontcolor = "#90b0f0"
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 7 — PERSISTENT STORAGE
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_storage {
    label = "Persistent Storage"
    style = "filled"
    fillcolor = "#1a1810"
    color = "#3a3020"
    fontcolor = "#7a6040"
    fontsize = 10

    db_sqlcipher [
      label = "SQLCipher DB  vault.db\n~/.local/share/io.apivault/vault.db\n(Tauri)  or  ~/.local/share/apiv-server/\n\nTable: vault\n  id=1 · data TEXT (JSON blob)\n\nTable: vault_audit\n  append-only · SHA-256 hash chain\n  action · provider · timestamp\n  entry_hash · prev_hash\n\nTable: users  ★ Phase 5\n  id · username · password_hash\n  is_owner · created_at · last_seen_at\n\nTable: user_tokens  ★ Phase 5\n  id · token_hash · user_id\n  description · expires_at\n\nTable: user_permissions  ★ Phase 5\n  user_id · scope_type · scope_value\n  permission"
      fillcolor = "#282010"
      color = "#e09a2b"
      fontcolor = "#f0c070"
      shape = cylinder
    ]

    salt_file [
      label = "vault.salt\n16 random bytes\n(Argon2id salt)"
      fillcolor = "#282010"
      color = "#e09a2b"
      fontcolor = "#f0c070"
      shape = note
    ]

    settings_file [
      label = "settings.json\n~/.config/io.apivault/\nPlain JSON (not encrypted)\ntheme · accentColor · cardSize\ngridColumns · autoLockMinutes\nsidebarSections · remote config\nenvCopyField · activePanel"
      fillcolor = "#282010"
      color = "#e09a2b"
      fontcolor = "#f0c070"
      shape = note
    ]

    vault_json_blob [
      label = "VaultData JSON blob\napi_keys: VaultEntry[]\nuser_categories: string[]\nprojects: Project[]\n\nVaultEntry fields incl.:\nversion_history (cap 50)\nlast_rotated_at  ★ Phase 5\nprojectIds · environment\nsecretType · expires_at"
      fillcolor = "#282010"
      color = "#e09a2b"
      fontcolor = "#f0c070"
      shape = note
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // LAYER 8 — ENCRYPTION
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_crypto {
    label = "Encryption / Auth"
    style = "filled"
    fillcolor = "#1e1418"
    color = "#3a2030"
    fontcolor = "#7a4060"
    fontsize = 10

    crypto_kdf [
      label = "Argon2id KDF\nPassword + salt → 32-byte VaultKey\nm=65536 KiB · t=3 · p=1\n(OWASP 2023 interactive)\nKey lives in VaultState(Mutex)\nNEVER written to disk"
      fillcolor = "#2a1820"
      color = "#e05252"
      fontcolor = "#f08080"
    ]

    crypto_sqlcipher [
      label = "SQLCipher AES-256-CBC\nPRAGMA key = \"x'<hex>'\"\nDB opened fresh per operation"
      fillcolor = "#2a1820"
      color = "#e05252"
      fontcolor = "#f08080"
    ]

    crypto_user_pw [
      label = "User Password Hashing  ★ Phase 5\nSHA-256(salt_16B || password)\nFormat: salt_hex:hash_hex"
      fillcolor = "#2a1820"
      color = "#e05252"
      fontcolor = "#f08080"
    ]

    crypto_token [
      label = "User Token  ★ Phase 5\n32 random bytes → 64-char hex\nStored as SHA-256(token)\nShown plaintext ONCE"
      fillcolor = "#2a1820"
      color = "#e05252"
      fontcolor = "#f08080"
    ]

    crypto_audit [
      label = "Audit Hash Chain\nentry_hash = SHA-256(\n  action|provider|ts|prev_hash)\nGenesis anchor = literal \"genesis\""
      fillcolor = "#2a1820"
      color = "#e05252"
      fontcolor = "#f08080"
    ]
  }

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — User flows
  // ═══════════════════════════════════════════════════════════════════════

  user_owner -> tauri_app [label = "launch\ndesktop app", color = "#e0525260"]
  user_owner -> apiv_server [label = "POST /api/unlock\n(master password)", color = "#e0525260"]
  user_member -> apiv_server [label = "POST /api/auth\n(username+pw or token)", color = "#7364c960"]
  cli_user -> apiv_cli [label = "apiv <cmd>", color = "#5889e060"]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — Frontend internal
  // ═══════════════════════════════════════════════════════════════════════

  ts_vault -> ts_state [label = "setRenderFn\nsetFinishInitFn", color = "#5889e040"]
  ts_vault -> ts_modals [label = "openAdd/Edit\ndeleteKey\nmarkAsRotated", color = "#5889e040"]
  ts_vault -> ts_projects [label = "doSetFilter\ncreate/rename/delete", color = "#5889e040"]
  ts_vault -> ts_render [label = "render()\nrenderGrid()", color = "#5889e040"]
  ts_vault -> ts_lock [label = "lockVault\nshowUnlockModal", color = "#e0525240"]
  ts_vault -> ts_tools [label = "initTools()", color = "#5889e040"]
  ts_vault -> ts_users [label = "initUsersPanel()\n★ Phase 5", color = "#7364c940"]
  ts_vault -> ts_settings [label = "openSettings", color = "#5889e040"]
  ts_vault -> ts_import_export [label = "copyAll\nexportAs\nimport", color = "#5889e040"]
  ts_vault -> ts_chunk_ops [label = "openChunkEdit\nModal", color = "#5889e040"]

  ts_render -> ts_state [label = "st (read)", color = "#5889e030"]
  ts_render -> ts_filters [label = "getFiltered\nsorted", color = "#5889e030"]
  ts_render -> ts_modals [label = "TYPE_CONFIG\nshowDropdown\nmarkAsRotated", color = "#5889e030"]
  ts_render -> ts_chunk_ops [label = "renderChunkCard\nexporters", color = "#5889e030"]
  ts_render -> ts_icons [label = "iconHTML", color = "#5889e030"]
  ts_render -> ts_utils [label = "esc · maskKey\nshowToast", color = "#5889e030"]
  ts_render -> ts_import_export [label = "parseEnvFile", color = "#5889e030"]

  ts_modals -> ts_state [label = "st (read/write)", color = "#5889e030"]
  ts_modals -> ts_icons [label = "openIconPicker\niconHTML", color = "#5889e030"]
  ts_modals -> ts_utils [color = "#5889e030"]

  ts_filters -> ts_state [label = "st (read)", color = "#5889e030"]
  ts_filters -> ts_types [label = "types", color = "#5889e020", style = dashed]

  ts_state -> ts_types [label = "types", color = "#5889e020", style = dashed]
  ts_state -> ts_utils [label = "hexAlpha", color = "#5889e030"]

  ts_lock -> ts_state [label = "st · TauriVaultStore\nSettings", color = "#e0525230"]
  ts_settings -> ts_state [label = "Settings\ntriggerRender", color = "#5889e030"]
  ts_tools -> ts_state [label = "switchPanel\nswitchTool", color = "#5889e030"]
  ts_tools -> ts_modals [label = "injectIntoForm\nquickGenerate", color = "#5889e030"]
  ts_users -> ts_state [label = "st.selectedUserId", color = "#7364c930"]
  ts_users -> ts_utils [label = "esc · showToast\nclipboardWrite", color = "#7364c930"]

  ts_projects -> ts_state [label = "st\ntriggerRender", color = "#5889e030"]
  ts_projects -> ts_chunk_ops [label = "makeXxxStarterChunks", color = "#5889e030"]
  ts_import_export -> ts_state [label = "st · Exporter", color = "#5889e030"]
  ts_import_export -> ts_filters [label = "getFiltered\nsorted", color = "#5889e030"]
  ts_chunk_ops -> ts_state [label = "st · Settings", color = "#5889e030"]

  ts_icons -> ts_types [label = "VaultEntry\n(type-only)", color = "#5889e020", style = dashed]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — Frontend ↔ Tauri IPC
  // ═══════════════════════════════════════════════════════════════════════

  ts_state -> tauri_invoke [label = "TauriVaultStore\n.invoke('...')", color = "#5ab05a60"]
  ts_users -> tauri_invoke [label = "invoke(\n'list_users'\n'create_user'\n'delete_user'\n'create_user_token'\n'revoke_user_token'\n'list_user_tokens'\n'get_user_permissions'\n'set_user_permissions')\n★ Phase 5", color = "#7364c960"]
  ts_tools -> tauri_invoke [label = "invoke(\n'generate_certificate'\n'generate_ssh_keypair')", color = "#5ab05a40"]
  ts_lock -> tauri_invoke [label = "invoke(\n'unlock_vault'\n'lock_vault'\n'vault_is_unlocked'\n'vault_exists')", color = "#e0525240"]

  tauri_invoke -> tauri_lib [label = "IPC dispatch", color = "#5ab05a60"]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — Tauri ↔ vault-core
  // ═══════════════════════════════════════════════════════════════════════

  tauri_lib -> vc_lib [label = "vault_core::\nderive_key · open_db\nload/save_vault\ninit_schema", color = "#5ab05a60"]
  tauri_lib -> vc_users [label = "vault_core::\nlist/create/delete_user\ncreate/revoke_user_token\nget/set_user_permissions\n★ Phase 5", color = "#7364c960"]
  tauri_lib -> vc_generators [label = "generate_certificate\ngenerate_ssh_keypair", color = "#5ab05a40"]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — apiv-server ↔ vault-core
  // ═══════════════════════════════════════════════════════════════════════

  apiv_server -> http_auth [label = "routes", color = "#5889e040"]
  apiv_server -> http_vault [label = "routes", color = "#5889e040"]
  apiv_server -> http_users [label = "routes\n★ Phase 5", color = "#7364c940"]
  apiv_server -> http_openapi [label = "route", color = "#3a406040"]
  apiv_server -> http_session [label = "owns", color = "#e09a2b40"]

  http_auth -> vc_lib [label = "derive_key\nopen_db\ninit_schema", color = "#5ab05a40"]
  http_auth -> vc_users [label = "verify_user_password\nverify_user_token\n★ Phase 5", color = "#7364c940"]
  http_vault -> vc_lib [label = "load/save_vault\nget_expiring\nload_audit", color = "#5ab05a40"]
  http_vault -> vc_users [label = "filter_vault_for_user\nmerge_user_vault_write\nget_user_permissions\n★ Phase 5", color = "#7364c940"]
  http_users -> vc_users [label = "full CRUD\n★ Phase 5", color = "#7364c960"]
  http_session -> vc_lib [label = "vault_key\nused to open_db\nper request", color = "#e09a2b40"]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — apiv-cli ↔ vault-core + HTTP
  // ═══════════════════════════════════════════════════════════════════════

  apiv_cli -> cli_cmds [label = "clap dispatch", color = "#5889e040"]
  cli_cmds -> vc_lib [label = "local mode:\ndirect DB access\n(Tauri app DB path)", color = "#5ab05a40"]
  cli_cmds -> apiv_server [label = "remote mode:\nHTTP via reqwest\n--server URL", color = "#5889e060", style = dashed]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — vault-core ↔ storage
  // ═══════════════════════════════════════════════════════════════════════

  vc_lib -> db_sqlcipher [label = "rusqlite\n(sqlcipher feature)", color = "#e09a2b60"]
  vc_lib -> salt_file [label = "read/write\n16B salt", color = "#e09a2b40"]
  vc_lib -> vault_json_blob [label = "JSON\nserialization", color = "#e09a2b40", style = dashed]
  db_sqlcipher -> vault_json_blob [label = "contains", color = "#e09a2b30", style = dashed]
  vc_users -> db_sqlcipher [label = "users · tokens\npermissions tables", color = "#7364c940"]

  tauri_lib -> settings_file [label = "load/save\nsettings", color = "#e09a2b40"]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — crypto
  // ═══════════════════════════════════════════════════════════════════════

  vc_lib -> crypto_kdf [label = "derive_key()", color = "#e0525240", style = dashed]
  vc_lib -> crypto_sqlcipher [label = "open_db()", color = "#e0525240", style = dashed]
  vc_lib -> crypto_audit [label = "append_audit()\nSHA-256 chain", color = "#e0525240", style = dashed]
  vc_users -> crypto_user_pw [label = "hash_password()\nverify_password_hash()", color = "#e0525240", style = dashed]
  vc_users -> crypto_token [label = "sha256_hex(token)\nrand::fill_bytes", color = "#e0525240", style = dashed]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — Tauri app bootstrap
  // ═══════════════════════════════════════════════════════════════════════

  tauri_app -> tauri_lib [label = "api_vault_lib::run()\nGDK_BACKEND=x11\nWEBKIT_DISABLE_COMPOSITING", color = "#5ab05a60"]
  tauri_app -> ts_vault [label = "serves dist/\n(frontendDist)", color = "#5889e060"]
  ts_vault -> css_bundle [label = "loads", color = "#3a506020", style = dashed]

  // ═══════════════════════════════════════════════════════════════════════
  // EDGES — RemoteVaultStore (settings panel wires this)
  // ═══════════════════════════════════════════════════════════════════════

  ts_settings -> ts_state [label = "swap st.store →\nRemoteVaultStore", color = "#7364c940", style = dashed]
  ts_state -> apiv_server [label = "RemoteVaultStore\nHTTP Bearer token\n(when remote enabled)", color = "#7364c940", style = dashed]

  // ═══════════════════════════════════════════════════════════════════════
  // LEGEND
  // ═══════════════════════════════════════════════════════════════════════

  subgraph cluster_legend {
    label = "Legend"
    style = "filled,rounded"
    fillcolor = "#0f1117"
    color = "#2a2e44"
    fontcolor = "#6a7090"
    fontsize = 9
    rank = sink

    legend [
      label = "★ Phase 5 new\n──  solid = primary data flow\n- -  dashed = type import or indirect\nColors:\n  purple = auth/RBAC\n  blue = TypeScript/frontend\n  green = Rust backend\n  amber = storage\n  red = auth/crypto\n  muted = utility"
      fillcolor = "#12141e"
      color = "#2a2e44"
      fontcolor = "#6a7090"
      shape = plaintext
    ]
  }
}
