{
  "name": "unenverse",
  "version": "0.42.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:frontend": "vite build",
    "build": "npm run build:frontend && tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all -- --check",
    "version": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "icons": "node scripts/gen-icons.mjs",
    "ui-lab": "playwright test",
    "ui-lab:report": "cat ui-lab/.artifacts/layout-findings.md",
    "site:build": "node scripts/build-site.mjs --out site",
    "site:check": "node scripts/check-site.mjs site",
    "docs": "node scripts/docs.mjs",
    "docs:rust": "cargo doc --workspace --no-deps",
    "preflight": "bash scripts/preflight.sh",
    "check": "npm run version:check && npm run format:check && npm run lint && npm run typecheck && npm test",
    "docs:all": "npm run docs && npm run docs:rust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "simple-icons": "^16.34.0",
    "typescript": "^7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "js-yaml": "^4.3.2",
    "qrcode-generator": "^2.0.4"
  }
}
