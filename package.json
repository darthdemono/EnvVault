{
  "name": "envvault",
  "version": "0.20.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:frontend": "vite build",
    "build": "npm run build:frontend && tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all -- --check",
    "version": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "icons": "node scripts/gen-icons.mjs",
    "ui-lab": "playwright test",
    "ui-lab:report": "cat ui-lab/.artifacts/layout-findings.md",
    "docs": "node scripts/docs.mjs",
    "docs:rust": "cargo doc --workspace --no-deps",
    "check": "npm run version:check && npm run format:check && npm run lint && npm run typecheck && npm test",
    "docs:all": "npm run docs && npm run docs:rust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "simple-icons": "^16.29.0",
    "typescript": "^5.5",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "js-yaml": "^4.2.0"
  }
}
