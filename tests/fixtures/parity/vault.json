{
  "api_keys": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "provider": "WgKey",
      "api_key": "SECRET_WG_PRIVATE",
      "price_type": "free",
      "secretType": "env_var",
      "categories": [],
      "projectIds": ["Universal"],
      "scopes": []
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "provider": "Postgres",
      "api_key": "pg-top-secret",
      "api_secret": "pg-secondary",
      "username": "pg_admin",
      "api_url": "postgres://db.internal:5432",
      "key_id": "primary",
      "price_type": "paid",
      "secretType": "connection_string",
      "categories": [],
      "projectIds": ["Universal"],
      "scopes": [],
      "extra_vars": [{ "key": "DB_NAME", "value": "app_production", "secret": false }]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "provider": "TLS",
      "api_key": "/etc/ssl/fullchain.pem",
      "price_type": "free",
      "secretType": "certificate",
      "categories": [],
      "projectIds": ["Universal"],
      "scopes": []
    }
  ],
  "user_categories": [],
  "projects": [
    { "id": "Universal", "name": "Universal", "description": "All keys belong here by default" },
    {
      "id": "vpn",
      "name": "VPN",
      "project_type": "wireguard",
      "chunks": [
        {
          "id": "c-wg-1",
          "name": "Interface",
          "chunk_type": "wg_interface",
          "fields": [
            { "key": "PrivateKey", "value": "${WgKey}", "field_type": "secret", "secret": true },
            { "key": "Address", "value": "10.8.0.1/24", "field_type": "subnet" },
            { "key": "ListenPort", "value": "51820", "field_type": "var" },
            { "key": "Empty", "value": "", "field_type": "var" }
          ]
        },
        {
          "id": "c-wg-2",
          "name": "Peer office",
          "chunk_type": "wg_peer",
          "fields": [
            { "key": "PublicKey", "value": "PEER_PUBLIC_KEY", "field_type": "var" },
            { "key": "AllowedIPs", "value": "10.8.0.2/32", "field_type": "var" },
            { "key": "PresharedKey", "value": "${Postgres_primary/secret}", "field_type": "secret", "secret": true }
          ]
        },
        {
          "id": "c-wg-3",
          "name": "Disabled peer",
          "chunk_type": "wg_peer",
          "disabled": true,
          "fields": [{ "key": "PublicKey", "value": "NEVER_EXPORTED", "field_type": "var" }]
        }
      ]
    },
    {
      "id": "stack",
      "name": "Stack",
      "project_type": "docker",
      "chunks": [
        {
          "id": "c-svc-1",
          "name": "Web App",
          "chunk_type": "docker_service",
          "fields": [
            { "key": "image", "value": "nginx:alpine", "field_type": "var" },
            { "key": "container_name", "value": "web", "field_type": "var" },
            { "key": "ports", "value": "8080:80,8443:443", "field_type": "port" },
            { "key": "volumes", "value": "./site:/usr/share/nginx/html\n./conf:/etc/nginx/conf.d", "field_type": "volume_mount" },
            { "key": "networks", "value": "frontend,backend", "field_type": "list" },
            { "key": "DATABASE_URL", "value": "${Postgres/url}", "field_type": "env_var" },
            { "key": "STATIC_VALUE", "value": "plain", "field_type": "env_var" },
            { "key": "restart", "value": "always", "field_type": "var" }
          ]
        },
        {
          "id": "c-net-1",
          "name": "networks",
          "chunk_type": "docker_network",
          "fields": [
            { "key": "frontend", "value": "bridge", "field_type": "var" },
            { "key": "backend", "value": "", "field_type": "var" }
          ]
        },
        {
          "id": "c-vol-1",
          "name": "volumes",
          "chunk_type": "docker_volume",
          "fields": [{ "key": "pgdata", "value": "", "field_type": "var" }]
        },
        {
          "id": "c-env-1",
          "name": "app.env",
          "chunk_type": "env_file",
          "fields": [
            { "key": "DB_PASSWORD", "value": "${Postgres}", "field_type": "secret", "secret": true },
            { "key": "DB_NAME", "value": "${Postgres/DB_NAME}", "field_type": "var" },
            { "key": "PORT", "value": "3000", "field_type": "var" },
            { "key": "MISSING", "value": "${NoSuchEntry}", "field_type": "var" }
          ]
        }
      ]
    },
    {
      "id": "edge",
      "name": "Edge",
      "project_type": "nginx",
      "chunks": [
        {
          "id": "c-up-1",
          "name": "app_upstream",
          "chunk_type": "nginx_upstream",
          "fields": [
            { "key": "server", "value": "10.0.0.5:8080,10.0.0.6:8080", "field_type": "endpoint" },
            { "key": "keepalive", "value": "32", "field_type": "var" }
          ]
        },
        {
          "id": "c-srv-1",
          "name": "HTTPS",
          "chunk_type": "nginx_server",
          "fields": [
            { "key": "listen", "value": "443 ssl http2", "field_type": "port" },
            { "key": "server_name", "value": "example.com", "field_type": "var" },
            { "key": "ssl_certificate", "value": "${TLS}", "field_type": "cert" },
            { "key": "blank", "value": "", "field_type": "var" }
          ]
        },
        {
          "id": "c-loc-1",
          "name": "location /",
          "chunk_type": "nginx_location",
          "fields": [
            { "key": "path", "value": "/", "field_type": "var" },
            { "key": "proxy_pass", "value": "http://app_upstream", "field_type": "endpoint" }
          ]
        }
      ]
    }
  ]
}
